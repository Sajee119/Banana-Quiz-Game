NODE_ENV=development
PORT=3000

# ===== Database =====
MONGODB_URI=your_mongodb_connection_string_here

# ===== Session =====
SESSION_SECRET=dev_secret_at_least_32_characters_long_change_me
COOKIE_SECURE=false
SESSION_REMEMBER_DAYS=30

# ===== App URL (used in OAuth callback URLs) =====
CLIENT_URL=http://localhost:5173
AUTH_CALLBACK_URL=http://localhost:3000

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Facebook OAuth =====
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ===== Password reset =====
PASSWORD_RESET_TTL_MINUTES=30

# ===== Email verification (OTP) =====
# New email/password accounts are only created after the 6-digit code is verified.
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_RESENDS=5
EMAIL_OTP_RESEND_SECONDS=30

# ===== Email delivery =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Banana Quiz <no-reply@bananaquiz.local>

# ===== Game tuning =====
GAME_BASE_POINTS=100
GAME_FAST_BONUS_MAX=50
GAME_FAST_THRESHOLD_MS=10000
GAME_MAX_STREAK_MULTIPLIER=2.0
BANANA_API_TIMEOUT_MS=8000
BANANA_API_MAX_RETRIES=3